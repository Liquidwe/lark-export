# 复制为 .env 后填写。.env 已被 git 和 Docker 构建忽略，不要提交真实的 Secret。

# 读取源文档的机器人（必填）
LARK_APP_ID=
LARK_APP_SECRET=

# 写入目标的机器人。跨组织迁移必填，留空时使用上面那组
LARK_TARGET_APP_ID=
LARK_TARGET_APP_SECRET=

# 访问端口
PORT=4310

# 读取时同时处理的节点数。默认 8，上限 32。调大主要对图片、附件多的目录有帮助
READ_CONCURRENCY=8

# 以下两项只在不用 Docker 运行时生效，Docker 下由 docker-compose.yml 固定
# 监听地址。工具没有登录功能，不要改成对外地址
HOST=127.0.0.1
# 数据目录，相对路径基于项目根目录
DATA_DIR=data
