# 复制为 .env 后填写。.env 已被 git 和 Docker 构建忽略，不要提交真实的 Secret。

# 读取源文档的机器人（必填）
LARK_APP_ID=
LARK_APP_SECRET=

# 新组织的机器人。团队成员迁移必填；管理员按链接迁移时留空则使用上面那组
LARK_TARGET_APP_ID=
LARK_TARGET_APP_SECRET=

# 管理员密码。不设置时无法用管理员身份登录。建议至少 12 位
ADMIN_PASSWORD=

# 用户访问这个工具的地址，不要以 / 结尾。两个机器人的后台都要把 <PUBLIC_URL>/api/auth/lark/callback 加到重定向 URL
PUBLIC_URL=http://localhost:4310

# 平台：lark 或 feishu。成员不输入链接，所以由这里决定接口域名。默认 lark
LARK_BRAND=lark
LARK_TARGET_BRAND=lark

# Docker 发布端口的地址。默认只有本机能访问。对内开放时改成内网地址，并放在 HTTPS 反向代理后面
BIND_ADDRESS=127.0.0.1

# 访问端口
PORT=4310

# 读取时同时处理的节点数。默认 8，上限 32。调大主要对图片、附件多的目录有帮助
READ_CONCURRENCY=8

# 迁移时同时写入的文档数。默认 6，上限 16。写入速度主要受 Lark 接口限速影响，调大不一定更快
WRITE_CONCURRENCY=6

# 以下两项只在不用 Docker 运行时生效，Docker 下由 docker-compose.yml 固定
# 监听地址
HOST=127.0.0.1
# 数据目录，相对路径基于项目根目录
DATA_DIR=data
